name: Update Google Scholar Publications

on:
  schedule:
    # 每天 UTC 时间 0点 运行 (北京时间早上8点)
    - cron: '0 0 * * *'
  workflow_dispatch: # 允许手动触发
  push:
    branches: [main] # 新增：向 main 分支 push 时自动触发本工作流

jobs:
  ReusableMatrixJobForDeployment:
    strategy:
      matrix:
        GOOGLE_SCHOLAR_ID: [8Cj1t08AAAAJ]
        RECORD_FILE: ["record/record.json"]
    uses: ./.github/workflows/update_scholar.yml
    with:
      GOOGLE_SCHOLAR_ID: ${{ matrix.GOOGLE_SCHOLAR_ID }}
      RECORD_FILE: ${{ matrix.RECORD_FILE }}
