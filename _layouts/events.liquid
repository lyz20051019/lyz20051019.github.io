---
layout: default # 继承你网站的默认布局
---
<!-- 单个活动详情页 -->
<div class="event-detail container my-5">
  <!-- 活动标题 -->
  <h1 class="text-center mb-4">{{ page.title }}</h1>
  <!-- 活动图片 -->
  <div class="text-center mb-4">
    <img src="{{ page.img | relative_url }}" alt="{{ page.title }}" class="img-fluid rounded" style="max-height: 400px;">
  </div>
  <!-- 活动日期 -->
  <p class="text-muted text-center">📅 {{ page.date | date: "%Y-%m-%d" }}</p>
  <!-- 活动详情内容 -->
  <div class="mt-5">
    {{ content }}
  </div>
</div>