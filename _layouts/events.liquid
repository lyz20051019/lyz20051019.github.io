---
layout: default
---

<!-- 纯净详情页容器，无标题、无预览模块 -->
<div class="event-detail container my-5">
  <!-- 纯静态展示图片：无链接、无标题 -->
  <div class="mb-4">
    <img 
      src="{{ page.img | relative_url }}" 
      class="img-fluid rounded w-100"
      style="object-fit: cover; max-height: 500px;"
    >
  </div>

  <!-- 活动日期（可选保留，简洁展示） -->
  <p class="text-muted mb-4">{{ page.date | date: "%Y年%m月%d日" }}</p>

  <!-- 活动详情正文（MD内容） -->
  <div class="event-content">
    {{ content }}
  </div>
</div>