<div class="events">
  {% if site.events != blank %}
    <!-- 活动网格布局：Bootstrap栅格系统 -->
    <div class="row g-4">
      {% assign events = site.events | reverse %}
      <!-- 数量限制（同新闻逻辑，可配置） -->
      {% if include.limit and page.events.limit %}
        {% assign events_limit = page.events.limit %}
      {% else %}
        {% assign events_limit = events | size %}
      {% endif %}

      {% for item in events limit: events_limit %}
        <!-- 响应式网格：电脑3张/平板2张/手机1张 -->
        <div class="col-lg-4 col-md-6 col-sm-12">
          <!-- 活动卡片：点击跳转 -->
          <a href="{{ item.url | relative_url }}" class="event-card text-decoration-none">
            <!-- 活动图片（取MD头部的img字段） -->
            <div class="event-img-wrapper">
              <img 
                src="{{ item.img | relative_url }}" 
                alt="{{ item.title }}" 
                class="img-fluid w-100 rounded"
                loading="lazy"
              >
            </div>
            <!-- 活动名称（图片下方小字） -->
            <h5 class="event-title text-center mt-2 text-dark">
              {{ item.title }}
            </h5>
          </a>
        </div>
      {% endfor %}
    </div>

  {% else %}
    <!-- 无活动时的提示（多语言兼容，同新闻） -->
    <p class="text-center text-muted">
      {{ site.data[site.active_lang].strings.no_events | default: "暂无活动" }}
    </p>
  {% endif %}
</div>